{"id": "FR:2026-23982", "jur": "US-Federal", "source": "federal_register", "kind": "notice", "docket": "", "title": "Preventing Outages and Enhancing the Resilience of the Electric Grid Formula Grants to States and Indian Tribes", "filed": "2026-11-25", "url": "https://www.federalregister.gov/documents/2026/11/25/2026-23982/preventing-outages-and-enhancing-the-resilience-of-the-electric-grid-formula-grants-to-states-and", "entity": "energy-department", "filing": "data/filings/US-Federal/federal_register/FR_2026-23982.json", "keywords": [], "party_hits": [], "run_id": "2026-11-25-1455", "docs": [{"url": "https://www.federalregister.gov/documents/full_text/text/2026/11/25/2026-23982.txt", "quality": null, "ocr": null, "chars": 0, "error": "blocked: HTTP 429 for https://www.federalregister.gov/documents/full_text/text/2026/11/25/2026-23982.txt"}], "meta": {"type": "Notice", "action": "Notice of intent.", "abstract": "The U.S. Department of Energy (DOE or the Department) and National Energy Technology Laboratory (NETL) intends to issue on behalf of the DOE Office of Electricity (OE), Amendment 000010 to DE-FOA- 0002736 Infrastructure Investment and Jobs Act (IIJA)--Preventing Outages and Enhancing the Resilience of the Electric Grid Formula Grants to States and Indian Tribes in Quarter (Q) 1 Fiscal Year (FY) 2027. Amendment 000010 to DE-FOA-0002736 will provide access to FY 2025 and FY 2026 formula grant allocations, which are available at www.netl.doe.gov/iijahub/grid-resilience. This \"Notice of Intent\" is for informational purposes only. The Department is not seeking comments on the information in this notice and all information contained in this notice is subject to change.", "comments_close_on": null, "effective_on": null, "term": "grid reliability"}}
