{"id": "FR:2026-24077", "jur": "US-Federal", "source": "federal_register", "kind": "notice", "docket": "", "title": "Agency Information Collection Proposed New Survey", "filed": "2026-11-27", "url": "https://www.federalregister.gov/documents/2026/11/27/2026-24077/agency-information-collection-proposed-new-survey", "entity": "energy-department, energy-information-administration", "filing": "data/filings/US-Federal/federal_register/FR_2026-24077.json", "keywords": ["colocation", "crypto", "data center", "hyperscale"], "party_hits": [], "run_id": "2026-11-26-1424", "docs": [{"url": "https://www.federalregister.gov/documents/full_text/text/2026/11/27/2026-24077.txt", "quality": "html", "ocr": false, "chars": 6508, "error": null}], "meta": {"type": "Notice", "action": "Notice and request for comments.", "abstract": "EIA invites public comment on the proposed collection of information, Data Center Energy Consumption Survey (DCECS), as required under the Paperwork Reduction Act of 1995. Form EIA-872 will collect facility-level data on energy consumption and energy-related physical and operational characteristics from all U.S. data centers with a design capacity of at least 1 megawatt (MW). DCECS will be used to produce national statistics on data center energy consumption and electricity demand.", "comments_close_on": "2027-01-26", "effective_on": null, "term": "data center"}}
