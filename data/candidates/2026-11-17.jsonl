{"id": "RSS:pjm_insidelines:https://insidelines.pjm.com/?p=210370", "jur": null, "source": "rss:pjm_insidelines", "kind": "news", "docket": null, "title": "PJM Plan Would Cut Interconnection Process Time in Half", "filed": "2026-11-16", "url": "https://insidelines.pjm.com/pjm-proposal-would-cut-interconnection-process-time-in-half/", "entity": null, "filing": "data/filings/NA/rss/RSS_pjm_insidelines_https_insidelines.pjm.com_p_210370.json", "keywords": ["data center", "interconnection", "transmission service"], "party_hits": [], "run_id": "2026-11-17-1350", "docs": [], "meta": {"bkey": "rss:pjm_insidelines", "rto": "PJM", "summary": " PJM has developed a new process designed to cut in half the time it takes to study new power generation and transmission service for large electricity users, including data centers. The Fast Energization process reduces projected timelines from two years to one and addresses the ongoing shortfall in new generation resources that is driving up [&#8230;]", "feed": "pjm_insidelines", "keyword_filter": true}}
{"id": "RSS:pjm_insidelines:https://insidelines.pjm.com/?p=210360", "jur": null, "source": "rss:pjm_insidelines", "kind": "news", "docket": null, "title": "PJM Proposes New Rules to Protect Grid Reliability as Data Center Demand Grows", "filed": "2026-11-16", "url": "https://insidelines.pjm.com/pjm-proposes-new-rules-to-protect-grid-reliability-as-data-center-demand-grows/", "entity": null, "filing": "data/filings/NA/rss/RSS_pjm_insidelines_https_insidelines.pjm.com_p_210360.json", "keywords": ["data center"], "party_hits": [], "run_id": "2026-11-17-1350", "docs": [], "meta": {"bkey": "rss:pjm_insidelines", "rto": "PJM", "summary": " A PJM proposal to FERC aims to ensure that data centers and other large computational loads remain connected to the grid and do not contribute to significant, unexpected load transfer events during transmission disturbances. The proposal, filed Monday, Nov. 16., arrives on the heels of several such events in the PJM region in recent years. [&#8230;]", "feed": "pjm_insidelines", "keyword_filter": true}}
